# Garmin LifestyleLogging/sleep analysis configuration.
# Relative input and output paths are resolved from the repository directory.
input_path: "GarminUserData/2026.04"
start_date: "2026-01-01"
end_date: "2026-12-31"
# Results are written below this repository's Out/ directory.
output_dir: "Out"
# Performance optimizations are enabled by default. Keep the backend serial
# unless a benchmark on a larger export proves parallel execution beneficial.
performance:
  enabled: true
  workers: 1
  backend: serial
# Analysis CSV output groups. Missing values default to true for compatibility
# with existing configurations.
analysis_output:
  all_combined: true
  all_classifications: true
  per_metric_combined: true
  per_metric_classifications: true
  json: true
# Inventory output is written below output_dir/available_metrics_and_activities.
# Each format can be enabled or disabled independently.
inventory_output:
  txt: true
  csv: true
# Optional separate source when input_path points directly to LifestyleLogging.json.
sleep_input: ""

# Count dates without a lifestyle entry as a negative observation.
# Set this to false for activities where absence should be ignored.
missing_activity_is_no: false
missing_activity_is_no_by_activity:
  Meditation: false

# Optional. When empty, all activities found in LifestyleLogging.json are used.
activities: []
# Activity names listed here are excluded from the analysis.
excluded_activities:
  - Example activity to exclude

# Optional direct comparisons between two explicitly defined activity groups.
# Activity names are enclosed in backticks. Supported operators are NOT, AND,
# OR, and parentheses (in that precedence order). A day that matches both
# groups is excluded from both groups so it is never used twice in one test.
# Missing activity entries follow missing_activity_is_no and its overrides.
activity_comparison_tests:
  - name: "Display off: 1h vs only 30min"
    group_a:
      label: "1 hour before bed"
      expression: "`Display off 1h before bed` AND `Display off 30min before bed`"
    group_b:
      label: "only 30 minutes before bed"
      expression: "`Display off 30min before bed` AND NOT `Display off 1h before bed`"

# Sleep metrics to analyze, mapped to accepted Garmin CSV/JSON field names.
# For a field whose JSON name is already the desired metric name, use an empty
# mapping such as `averageHR:`. A scalar value such as `averageHR: averageHR`
# is also accepted. This allows direct JSON fields and aliases to be mixed.
sleep_metrics:
  Sleep_Score:
    - Score
    - Sleep Score
  Sleep_Duration:
    - Dauer
    - Sleep Duration
  HRV:
    - HFV-Status
    - HRV
  RHR:
    - Ruheherzfrequenz
    - Resting Heart Rate
  averageHR:
  restlessMomentCount:
  awakeSleepSeconds:
  awakeCount:
  averageSPO2:

# Interpretation of significant differences. The standard metrics remain
# unchanged. Optional metrics can be added to sleep_metrics and configured
# here; custom metrics not listed here default to higher.
metric_directions:
  RHR: lower
  Stress: lower
  Restless_Moments: lower
  Awake_Time: lower

# Optional metrics calculated from scalar sleep fields and/or metrics above.
# Formulas support names, numbers, +, -, *, /, and parentheses. Sleep_Duration
# is normalized to hours by the analysis, while deepSleepSeconds is seconds.
# Use `deepSleepSeconds / Sleep_Duration` for seconds per sleep hour, or multiply
# the denominator by 3600 for the deep-sleep share of total sleep duration.
derived_sleep_metrics:
  DeepSleep_Share:
    formula: "deepSleepSeconds / (Sleep_Duration * 3600)"

value_interval: 0.80
confidence_interval: 0.95
significance_level: 0.05
